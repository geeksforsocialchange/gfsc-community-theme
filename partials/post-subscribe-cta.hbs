{{#if @site.members_enabled}}
{{#unless @member}}
<section class="gh-post-subscribe gh-canvas">
    <h3 class="gh-post-subscribe-title">Enjoyed this post?</h3>
    <p class="gh-post-subscribe-description">Get new posts delivered to your inbox — community tech, local activism, and more.</p>
    <button class="gh-btn gh-primary-btn gh-post-subscribe-btn" data-portal="signup">Subscribe for free</button>
</section>
{{/unless}}
{{/if}}
